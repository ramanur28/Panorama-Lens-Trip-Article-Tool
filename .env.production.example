# =================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =================================================================
# File ini adalah template untuk .env di server VPS production.
# Pada saat deploy pertama kali, salin file ini menjadi .env di VPS atau lokal:
# cp .env.production.example .env.production

# Port aplikasi di dalam container
PORT=3001
NODE_ENV=production

# -----------------------------------------------------------------
# 1. Kredensial Login Aplikasi (Admin & User)
# -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_sangat_kuat_123!

USER_USERNAME=editor
USER_PASSWORD=ganti_dengan_password_user_yang_sangat_kuat_123!

# -----------------------------------------------------------------
# 2. AI API Keys
# -----------------------------------------------------------------
# Google Gemini API Key (Dapatkan di https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (Opsional / jika menggunakan fitur OpenAI)
OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------
# 3. WordPress Integration (Opsional)
# -----------------------------------------------------------------
WP_URL=https://panoramalenstrip.com
WP_USERNAME=ramanur321@gmail.com
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
