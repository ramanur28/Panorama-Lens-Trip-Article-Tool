# =================================================================
# KONFIGURASI AUTO-DEPLOY (DOCKER HUB & VPS)
# =================================================================
# Salin file ini menjadi .env.deploy dan sesuaikan dengan data Anda:
# cp .env.deploy.example .env.deploy

# 1. Konfigurasi Docker Hub
# Username akun Docker Hub Anda (https://hub.docker.com)
DOCKERHUB_USERNAME=username_dockerhub_anda
# Nama repository di Docker Hub (akan dibuat otomatis jika public)
DOCKERHUB_REPO=gemini-article-generator
# Tag image default (latest, v1.0.0, dsb.)
IMAGE_TAG=latest

# 2. Konfigurasi Server Production (VPS)
# Alamat IP publik atau domain server VPS Anda
VPS_HOST=103.xxx.xxx.xxx
# Username SSH di VPS (misal: root atau ubuntu)
VPS_USER=root
# Port SSH di VPS (default: 22)
VPS_PORT=22
# Path ke SSH Private Key lokal (opsional jika menggunakan SSH Key non-default)
# Contoh: ~/.ssh/id_rsa
# VPS_SSH_KEY=~/.ssh/id_rsa

# Direktori tempat aplikasi dideploy di server VPS
VPS_DEPLOY_DIR=/opt/gemini-article-generator

# 3. Arsitektur Target Build
# linux/amd64 memastikan image kompatibel dengan sebagian besar VPS (x86_64)
BUILD_PLATFORM=linux/amd64
