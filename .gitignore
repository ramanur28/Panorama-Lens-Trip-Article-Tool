# =================================================================
# 1. SENSITIVE CREDENTIALS & ENVIRONMENT VARIABLES
# =================================================================
# Environment files (contains API keys, passwords, VPS credentials)
.env
.env.*
.env*.local

# Whitelist safe template / example files
!.env.example
!.env.*.example
!.env*.example

# Private Keys, Certificates, and SSH Credentials
*.pem
*.key
*.pub
*.crt
*.cer
*.cert
*.pfx
*.p12
id_rsa*
id_ed25519*
.ssh/

# Secret & API key files
secrets/
*.credentials
credentials.json
client_secret*.json

# =================================================================
# 2. DATABASE DUMPS & EXPORTS (CONTAINS LIVE SESSIONS, KEYS, USERS)
# =================================================================
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.dump
*.rdb

# Whitelist safe sanitized example database schemas
!php-version/database.example.sql
!*.schema.sql
!*.example.sql

# =================================================================
# 3. RUNTIME DATA, STORAGE & LOCAL BACKUPS
# =================================================================
# Node.js backend storage (contains admin settings, articles, and uploads)
data/*
!data/.gitkeep
!data/uploads/

# Backups folder
backups/*
!backups/.gitkeep

# User media uploads
uploads/*
!uploads/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
php-version/uploads/*
!php-version/uploads/.gitkeep

# Temporary & cache directories
temp/
tmp/
.temp/
.tmp/

# =================================================================
# 4. LARGE ARCHIVES & HOSTING/CPANEL PACKAGES
# =================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.iso
panorama-article-tool-cpanel.zip

# =================================================================
# 5. PHP APPLICATION SPECIFICS
# =================================================================
# Local configuration overrides
php-version/config.local.php
php-version/*.log

# =================================================================
# 6. LOGS & PROCESS RUNTIME
# =================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Process IDs & locks
pids
*.pid
*.seed
*.pid.lock

# =================================================================
# 7. DEPENDENCIES & BUILD ARTIFACTS
# =================================================================
node_modules/
jspm_packages/
bower_components/

# Build outputs
dist/
dist-ssr/
build/
.next/
.nuxt/
.vuepress/dist
.serverless/

# Caches
.cache/
.parcel-cache/
.eslintcache
.npm/
*.tsbuildinfo
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history
.yarn-integrity

# =================================================================
# 8. TEST & COVERAGE
# =================================================================
coverage/
*.lcov
.nyc_output/

# =================================================================
# 9. IDE, EDITOR & OS METADATA
# =================================================================
# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~